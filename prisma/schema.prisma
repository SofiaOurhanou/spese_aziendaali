generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  DIPENDENTE
  RESPONSABILE
}

enum StatoRimborso {
  IN_ATTESA
  APPROVATA
  RIFIUTATA
  LIQUIDATA
}

model User {
  id       Int    @id @default(autoincrement())
  nome     String
  cognome  String
  email    String @unique
  password String
  ruolo    Role

  // richieste create dal dipendente
  richieste RichiestaRimborso[] @relation("DipendenteRichieste")

  // richieste valutate dal responsabile
  valutazioni RichiestaRimborso[] @relation("ResponsabileValutazione")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CategoriaSpesa {
  id          Int    @id @default(autoincrement())
  descrizione String @unique

  richieste RichiestaRimborso[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RichiestaRimborso {
  id Int @id @default(autoincrement())

  dataInserimento DateTime @default(now())
  dataSpesa       DateTime

  importo Decimal @db.Decimal(10, 2)

  descrizione               String
  riferimentoGiustificativo String?

  stato StatoRimborso @default(IN_ATTESA)

  // Dipendente che ha creato la richiesta
  dipendenteId Int
  dipendente User @relation("DipendenteRichieste", fields: [dipendenteId], references: [id])

  // Categoria
  categoriaId Int
  categoria   CategoriaSpesa @relation(fields: [categoriaId], references: [id])

  // Responsabile che ha valutato
  responsabileValutazioneId Int?
  responsabileValutazione User? @relation("ResponsabileValutazione", fields: [responsabileValutazioneId], references: [id])

  dataValutazione DateTime?

  motivazioneRifiuto String?

  dataLiquidazione DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dipendenteId])
  @@index([categoriaId])
  @@index([stato])
  @@index([dataSpesa])
}
